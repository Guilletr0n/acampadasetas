---
import ManifestoView from "../components/ManifestoView.astro";

export const prerender = false;

// Actualizar cookie de preferencia para que recuerde que eligió inglés
Astro.cookies.set("preferred_lang", "en", {
  path: "/",
  maxAge: 60 * 60 * 24 * 365,
  sameSite: "lax",
});
---

<ManifestoView lang="en" />
