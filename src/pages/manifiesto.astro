---
import ManifestoView from "../components/ManifestoView.astro";
import {
  parsePreferredLanguage,
  SUPPORTED_LANGUAGES,
  type LanguageCode,
} from "../lib/manifiesto-translations";

export const prerender = false;

// 1. Verificar si hay un parámetro de idioma explícito en la URL (?lang=es, ?lang=en, etc.)
const url = new URL(Astro.request.url);
const urlLang = url.searchParams.get("lang")?.toLowerCase() as
  | LanguageCode
  | undefined;

if (urlLang && SUPPORTED_LANGUAGES.includes(urlLang)) {
  Astro.cookies.set("preferred_lang", urlLang, {
    path: "/",
    maxAge: 60 * 60 * 24 * 365,
    sameSite: "lax",
  });
  if (urlLang !== "es") {
    return Astro.redirect(`/manifiesto-${urlLang}`);
  }
} else {
  // 2. Verificar si el usuario ya tiene una preferencia guardada en cookies
  const cookieLang = Astro.cookies.get("preferred_lang")?.value?.toLowerCase() as
    | LanguageCode
    | undefined;
  if (cookieLang && SUPPORTED_LANGUAGES.includes(cookieLang)) {
    if (cookieLang !== "es") {
      return Astro.redirect(`/manifiesto-${cookieLang}`);
    }
  } else {
    // 3. Detección automática por sistema operativo / navegador (Accept-Language header)
    const acceptHeader = Astro.request.headers.get("accept-language");
    const detectedLang = parsePreferredLanguage(acceptHeader);
    if (detectedLang !== "es") {
      return Astro.redirect(`/manifiesto-${detectedLang}`);
    }
  }
}
---

<ManifestoView lang="es">
  <script is:inline slot="head">
    (function () {
      try {
        const params = new URLSearchParams(window.location.search);
        const qLang = params.get("lang");
        if (qLang === "es" || params.has("noredirect")) {
          localStorage.setItem("preferred_lang", "es");
          return;
        }
        if (qLang && ["en", "fr", "it", "pt", "el"].includes(qLang)) {
          localStorage.setItem("preferred_lang", qLang);
          window.location.replace("/manifiesto-" + qLang);
          return;
        }

        const stored = localStorage.getItem("preferred_lang");
        if (stored === "es") return;
        if (stored && ["en", "fr", "it", "pt", "el"].includes(stored)) {
          window.location.replace("/manifiesto-" + stored);
          return;
        }

        const navLangs = navigator.languages || [navigator.language || ""];
        for (let i = 0; i < navLangs.length; i++) {
          const code = (navLangs[i] || "").toLowerCase().split("-")[0];
          if (code === "es") break;
          if (["en", "fr", "it", "pt", "el"].includes(code)) {
            window.location.replace("/manifiesto-" + code);
            break;
          }
        }
      } catch (e) {}
    })();
  </script>
</ManifestoView>
