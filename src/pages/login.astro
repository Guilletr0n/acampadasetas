---
import Layout from "../layouts/Layout.astro";
import { getCurrentUser } from "../lib/auth";

export const prerender = false;

const user = await getCurrentUser(Astro.cookies);
if (user && user.approved) {
  return Astro.redirect('/admin/sections');
}
---

<Layout title="Iniciar Sesión" isDashboard={true}>
  <main class="min-h-screen flex items-center justify-center p-4 bg-[#fcf2df]">
    <div class="card w-full max-w-md bg-white shadow-2xl border-2 border-[#1d1d1b]">
      <div class="card-body">
        <div class="text-center mb-4">
          <span class="text-xs uppercase tracking-widest font-bold text-[#af0b56] block">
            ACCESO PANEL DE CONTROL
          </span>
          <h2 class="text-4xl font-londrina text-[#1d1d1b] m-0">ACAMPADA SETAS</h2>
          <p class="text-xs text-gray-500 mt-1">Gestión de contenidos, secciones y galería</p>
        </div>

        <div id="error-box" class="hidden alert alert-error text-xs font-semibold py-2"></div>

        <form id="login-form" class="space-y-4">
          <div class="form-control">
            <label class="label font-bold text-xs" for="email">
              <span class="label-text">CORREO ELECTRÓNICO</span>
            </label>
            <input 
              type="email" 
              id="email" 
              name="email" 
              class="input input-bordered w-full border-2 border-[#1d1d1b] focus:border-[#af0b56]" 
              placeholder="arrendataria@zohomail.com" 
              required 
            />
          </div>

          <div class="form-control">
            <label class="label font-bold text-xs" for="password">
              <span class="label-text">CONTRASEÑA</span>
            </label>
            <input 
              type="password" 
              id="password" 
              name="password" 
              class="input input-bordered w-full border-2 border-[#1d1d1b] focus:border-[#af0b56]" 
              placeholder="••••••••" 
              required 
            />
          </div>

          <div class="form-control mt-4">
            <button 
              type="submit" 
              id="submit-btn" 
              class="btn bg-[#af0b56] hover:bg-[#8f0946] text-white border-2 border-[#1d1d1b] text-base font-bold shadow-[2px_2px_0px_#1d1d1b]"
            >
              Iniciar Sesión →
            </button>
          </div>
        </form>

        <!-- Quick Demo Credentials Box -->
        <div class="mt-6 pt-4 border-t-2 border-dashed border-gray-300 text-xs">
          <span class="font-bold text-gray-600 block mb-2 uppercase">Credenciales para desarrollo local:</span>
          <div class="grid grid-cols-2 gap-2">
            <button
              type="button"
              onclick="fillCreds('arrendataria@zohomail.com', 'admin123')"
              class="p-2 border border-[#1d1d1b] bg-amber-50 hover:bg-amber-100 text-left transition-all rounded shadow-sm"
            >
              <strong class="block text-[#af0b56] font-bold">★ Admin</strong>
              <span class="text-[10px] text-gray-700 block truncate">arrendataria@...</span>
              <span class="text-[9px] text-gray-500">Gestión total</span>
            </button>

            <button
              type="button"
              onclick="fillCreds('editor@acampadasetas.org', 'editor123')"
              class="p-2 border border-[#1d1d1b] bg-blue-50 hover:bg-blue-100 text-left transition-all rounded shadow-sm"
            >
              <strong class="block text-blue-700 font-bold">✎ Editora</strong>
              <span class="text-[10px] text-gray-700 block truncate">editor@...</span>
              <span class="text-[9px] text-gray-500">Contenidos</span>
            </button>
          </div>
        </div>

        <div class="mt-4 pt-3 border-t border-gray-200 text-center text-xs">
          <span class="text-gray-600">¿Quieres colaborar redactando?</span>
          <a href="/join-editor" class="text-[#af0b56] font-bold underline hover:opacity-80 block mt-1">
            Postularse como Editora →
          </a>
        </div>
      </div>
    </div>
  </main>

  <script is:inline>
    function fillCreds(email, pass) {
      document.getElementById('email').value = email;
      document.getElementById('password').value = pass;
    }

    const form = document.getElementById('login-form');
    const submitBtn = document.getElementById('submit-btn');
    const errorBox = document.getElementById('error-box');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorBox.classList.add('hidden');
      submitBtn.disabled = true;
      submitBtn.innerText = 'Verificando...';

      const email = document.getElementById('email').value.trim();
      const password = document.getElementById('password').value;

      try {
        const res = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password }),
        });

        const data = await res.json();

        if (res.ok && data.success) {
          const params = new URLSearchParams(window.location.search);
          const redirect = params.get('redirect') || '/admin/sections';
          window.location.href = redirect;
        } else {
          errorBox.innerText = data.error || 'Credenciales inválidas';
          errorBox.classList.remove('hidden');
          submitBtn.disabled = false;
          submitBtn.innerText = 'Iniciar Sesión →';
        }
      } catch (err) {
        errorBox.innerText = 'Error de conexión con el servidor.';
        errorBox.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.innerText = 'Iniciar Sesión →';
      }
    });
  </script>
</Layout>
