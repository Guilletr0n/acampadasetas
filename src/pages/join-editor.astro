---
import Layout from "../layouts/Layout.astro";
import { getCurrentUser } from "../lib/auth";

export const prerender = false;

const user = await getCurrentUser(Astro.cookies);
if (user) {
  return Astro.redirect('/admin/home');
}
---

<Layout title="Unirse como Editora" isDashboard={true}>
  <main class="min-h-screen flex items-center justify-center p-4 bg-base-200">
    <div class="card w-full max-w-md bg-base-100 shadow-xl">
      <div class="card-body">
        <div class="text-center mb-3">
          <span class="text-xs uppercase tracking-widest font-bold text-[#af0b56] block">
            CONVOCATORIA ABIERTA
          </span>
          <h2 class="text-4xl font-londrina text-neutral m-0">UNIRSE AL EQUIPO</h2>
          <p class="text-xs text-base-content/70 mt-1">Solicitud de acceso para edición y publicación</p>
        </div>

        <div class="alert alert-info py-2 text-xs mb-2">
          <div>
            <p class="font-bold">Proceso de Incorporación:</p>
            <p>
              Al registrarte se crea tu postulación en estado <strong>pendiente de aprobación</strong> con rol de lectora. Un administrador validará tu cuenta y te asignará el rol de <strong>Editora</strong> para habilitar la edición de contenidos.
            </p>
          </div>
        </div>

        <div id="error-box" class="hidden alert alert-error text-xs font-semibold py-2"></div>
        <div id="success-box" class="hidden alert alert-success text-xs font-semibold py-3 text-center">
          <div>
            <h3 class="font-bold text-sm">Solicitud recibida con éxito</h3>
            <p class="mt-1">Tu cuenta está pendiente de revisión por el equipo de administración.</p>
            <a href="/login" class="btn btn-sm btn-outline mt-3">Ir al Inicio de Sesión</a>
          </div>
        </div>

        <form id="join-form" class="space-y-4">
          <div class="form-control">
            <label class="label" for="name">
              <span class="label-text font-bold text-xs">NOMBRE O COLECTIVO</span>
            </label>
            <input 
              type="text" 
              id="name" 
              name="name" 
              class="input input-bordered w-full" 
              placeholder="Ej: Asamblea Centro, Clara..." 
              required 
            />
          </div>

          <div class="form-control">
            <label class="label" for="email">
              <span class="label-text font-bold text-xs">CORREO ELECTRÓNICO</span>
            </label>
            <input 
              type="email" 
              id="email" 
              name="email" 
              class="input input-bordered w-full" 
              placeholder="tu@correo.com" 
              required 
            />
          </div>

          <div class="form-control">
            <label class="label" for="password">
              <span class="label-text font-bold text-xs">CONTRASEÑA</span>
            </label>
            <input 
              type="password" 
              id="password" 
              name="password" 
              class="input input-bordered w-full" 
              placeholder="Mínimo 6 caracteres" 
              minlength="6" 
              required 
            />
          </div>

          <div class="form-control mt-4">
            <button 
              type="submit" 
              id="submit-btn" 
              class="btn btn-primary w-full"
            >
              Enviar Solicitud de Editora
            </button>
          </div>
        </form>

        <div class="mt-4 pt-3 border-t border-base-200 text-center text-xs">
          <span class="text-base-content/70">¿Ya tienes cuenta aprobada?</span>
          <a href="/login" class="text-[#af0b56] font-bold underline hover:opacity-80 block mt-1">
            Iniciar Sesión aquí
          </a>
        </div>
      </div>
    </div>
  </main>

  <script is:inline>
    const form = document.getElementById('join-form');
    const submitBtn = document.getElementById('submit-btn');
    const errorBox = document.getElementById('error-box');
    const successBox = document.getElementById('success-box');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorBox.classList.add('hidden');
      submitBtn.disabled = true;
      submitBtn.innerText = 'Enviando...';

      const name = document.getElementById('name').value.trim();
      const email = document.getElementById('email').value.trim();
      const password = document.getElementById('password').value;

      try {
        const res = await fetch('/api/auth/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, email, password }),
        });

        const data = await res.json();

        if (res.ok && data.success) {
          form.classList.add('hidden');
          successBox.classList.remove('hidden');
        } else {
          errorBox.innerText = data.error || 'Error al procesar la solicitud';
          errorBox.classList.remove('hidden');
          submitBtn.disabled = false;
          submitBtn.innerText = 'Enviar Solicitud de Editora';
        }
      } catch (err) {
        errorBox.innerText = 'Error de conexión con el servidor.';
        errorBox.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.innerText = 'Enviar Solicitud de Editora';
      }
    });
  </script>
</Layout>
