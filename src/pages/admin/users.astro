---
import Layout from "../../layouts/Layout.astro";
import AdminNav from "../../components/AdminNav.astro";
import { getUsers } from "../../lib/users";
import { getCurrentUser } from "../../lib/auth";
import { Check, Trash2, Key } from "lucide-astro";

export const prerender = false;

const currentUser = await getCurrentUser(Astro.cookies);
if (!currentUser || currentUser.role !== 'admin') {
  return Astro.redirect('/admin/home');
}

const users = await getUsers();
---

<Layout title="Gestión de Usuarios | Admin CMS" isDashboard={true}>
  <AdminNav activeTab="users" user={currentUser} />

  <main class="max-w-6xl mx-auto p-6">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6">
      <div>
        <h1 class="text-4xl font-londrina text-neutral">CONTROL DE USUARIOS Y ROLES</h1>
        <p class="text-xs text-base-content/70">Aprobación de postulaciones a editora, cambio de roles y moderación de cuentas.</p>
      </div>

      <!-- Filters -->
      <div class="flex items-center gap-2">
        <select id="filter-role" class="select select-bordered select-sm">
          <option value="all">Todos los roles</option>
          <option value="admin">Admin</option>
          <option value="editor">Editor</option>
          <option value="reader">Reader</option>
        </select>
        <select id="filter-status" class="select select-bordered select-sm">
          <option value="all">Todos los estados</option>
          <option value="pending">Pendientes</option>
          <option value="approved">Aprobados</option>
        </select>
      </div>
    </div>

    <!-- User Table -->
    <div class="overflow-x-auto bg-base-100 rounded-box shadow">
      <table class="table w-full">
        <thead class="bg-base-200 text-base-content font-bold text-xs uppercase">
          <tr>
            <th>Nombre / Colectivo</th>
            <th>Email</th>
            <th class="whitespace-nowrap">Rol</th>
            <th class="whitespace-nowrap">Estado Aprobación</th>
            <th class="whitespace-nowrap">Fecha Registro</th>
            <th class="text-right whitespace-nowrap">Acciones</th>
          </tr>
        </thead>
        <tbody id="users-tbody">
          {users.map((u) => (
            <tr class="hover user-row border-b border-base-200" data-role={u.role} data-approved={u.approved ? 'approved' : 'pending'}>
              <td class="font-bold text-sm">
                {u.displayName}
                {u.uid === currentUser.uid && <span class="badge badge-xs badge-neutral ml-1">Tú</span>}
              </td>
              <td class="font-mono text-xs text-base-content/70">{u.email}</td>
              <td class="whitespace-nowrap">
                <select 
                  class="select select-bordered select-xs role-select font-semibold" 
                  data-uid={u.uid}
                  disabled={u.uid === currentUser.uid}
                >
                  <option value="reader" selected={u.role === 'reader'}>Reader</option>
                  <option value="editor" selected={u.role === 'editor'}>Editor</option>
                  <option value="admin" selected={u.role === 'admin'}>Admin</option>
                </select>
              </td>
              <td class="whitespace-nowrap">
                <label class="cursor-pointer label justify-start gap-2">
                  <input 
                    type="checkbox" 
                    class="toggle toggle-success toggle-sm approval-toggle" 
                    checked={u.approved} 
                    data-uid={u.uid}
                    disabled={u.uid === currentUser.uid}
                  />
                  <span class={`badge badge-sm font-semibold ${u.approved ? 'badge-success' : 'badge-warning'}`}>
                    {u.approved ? 'Aprobado' : 'Pendiente'}
                  </span>
                </label>
              </td>
              <td class="text-xs text-base-content/60 font-mono whitespace-nowrap">
                {new Date(u.createdAt).toLocaleDateString('es-ES')}
              </td>
              <td class="text-right whitespace-nowrap">
                <div class="flex justify-end gap-2">
                  <button 
                    class="btn btn-xs btn-outline btn-warning change-pwd-btn whitespace-nowrap inline-flex items-center gap-1" 
                    data-uid={u.uid} 
                    data-name={u.displayName}
                    data-email={u.email}
                    title="Cambiar contraseña"
                  >
                    <Key class="w-3.5 h-3.5" />
                    <span>Contraseña</span>
                  </button>

                  {u.uid !== currentUser.uid && (
                    <>
                      {!u.approved && (
                        <button 
                          class="btn btn-xs btn-primary approve-btn whitespace-nowrap inline-flex items-center gap-1" 
                          data-uid={u.uid}
                        >
                          <Check class="w-3.5 h-3.5" />
                          <span>Aprobar</span>
                        </button>
                      )}
                      <button 
                        class="btn btn-xs btn-error delete-btn whitespace-nowrap" 
                        data-uid={u.uid} 
                        data-name={u.displayName}
                        title="Eliminar"
                        aria-label="Eliminar"
                      >
                        <Trash2 class="w-3.5 h-3.5" />
                      </button>
                    </>
                  )}
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Modal Cambiar Contraseña -->
    <dialog id="modal-change-pwd" class="modal">
      <div class="modal-box max-w-sm">
        <h3 class="font-bold text-lg mb-1 flex items-center gap-2">
          <Key class="w-5 h-5 text-warning" />
          <span>Cambiar Contraseña</span>
        </h3>
        <p class="text-xs text-base-content/70 mb-4" id="modal-pwd-user-info"></p>
        <form id="form-change-pwd">
          <input type="hidden" id="modal-pwd-uid" />
          <div class="form-control mb-4">
            <label class="label py-1"><span class="label-text text-xs font-semibold">Nueva Contraseña</span></label>
            <input type="password" id="modal-pwd-input" class="input input-bordered input-sm w-full" placeholder="Introduce la nueva clave..." minlength="6" required />
          </div>
          <div class="modal-action">
            <button type="button" class="btn btn-sm btn-ghost" onclick="document.getElementById('modal-change-pwd').close()">Cancelar</button>
            <button type="submit" class="btn btn-sm btn-primary">Guardar</button>
          </div>
        </form>
      </div>
      <form method="dialog" class="modal-backdrop"><button>Cerrar</button></form>
    </dialog>
  </main>

  <script is:inline>
    // Filters logic
    const filterRole = document.getElementById('filter-role');
    const filterStatus = document.getElementById('filter-status');
    const rows = document.querySelectorAll('.user-row');

    function applyFilters() {
      const selectedRole = filterRole.value;
      const selectedStatus = filterStatus.value;

      rows.forEach(row => {
        const role = row.getAttribute('data-role');
        const approved = row.getAttribute('data-approved');

        const roleMatch = (selectedRole === 'all' || role === selectedRole);
        const statusMatch = (selectedStatus === 'all' || approved === selectedStatus);

        if (roleMatch && statusMatch) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    }

    filterRole.addEventListener('change', applyFilters);
    filterStatus.addEventListener('change', applyFilters);

    // Update role
    document.querySelectorAll('.role-select').forEach(select => {
      select.addEventListener('change', async (e) => {
        const uid = e.target.dataset.uid;
        const newRole = e.target.value;
        try {
          const res = await fetch(`/api/admin/users/${uid}`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ role: newRole }),
          });
          if (res.ok) {
            e.target.closest('tr').setAttribute('data-role', newRole);
          } else {
            alert('Error al actualizar el rol');
          }
        } catch {
          alert('Error de conexión');
        }
      });
    });

    // Toggle approval
    document.querySelectorAll('.approval-toggle').forEach(toggle => {
      toggle.addEventListener('change', async (e) => {
        const uid = e.target.dataset.uid;
        const approved = e.target.checked;
        try {
          const res = await fetch(`/api/admin/users/${uid}`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ approved }),
          });
          if (res.ok) {
            window.location.reload();
          } else {
            alert('Error al actualizar aprobación');
          }
        } catch {
          alert('Error de conexión');
        }
      });
    });

    // Quick approve as editor
    document.querySelectorAll('.approve-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const uid = e.target.dataset.uid;
        try {
          const res = await fetch(`/api/admin/users/${uid}`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ approved: true, role: 'editor' }),
          });
          if (res.ok) {
            window.location.reload();
          } else {
            alert('Error al aprobar usuario');
          }
        } catch {
          alert('Error de conexión');
        }
      });
    });

    // Delete user
    document.querySelectorAll('.delete-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const uid = e.target.dataset.uid;
        const name = e.target.dataset.name;
        if (confirm(`¿Estás segura de eliminar la cuenta de "${name}"? Esta acción no se puede deshacer.`)) {
          try {
            const res = await fetch(`/api/admin/users/${uid}`, {
              method: 'DELETE',
            });
            if (res.ok) {
              window.location.reload();
            } else {
              alert('Error al eliminar usuario');
            }
          } catch {
            alert('Error de conexión');
          }
        }
      });
    });

    // Change Password Modal
    const modalPwd = document.getElementById('modal-change-pwd');
    const modalPwdUid = document.getElementById('modal-pwd-uid');
    const modalPwdInput = document.getElementById('modal-pwd-input');
    const modalPwdUserInfo = document.getElementById('modal-pwd-user-info');
    const formChangePwd = document.getElementById('form-change-pwd');

    document.querySelectorAll('.change-pwd-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        modalPwdUid.value = btn.dataset.uid;
        modalPwdUserInfo.textContent = `${btn.dataset.name} (${btn.dataset.email})`;
        modalPwdInput.value = '';
        modalPwd.showModal();
      });
    });

    formChangePwd.addEventListener('submit', async (e) => {
      e.preventDefault();
      const uid = modalPwdUid.value;
      const password = modalPwdInput.value;
      try {
        const res = await fetch(`/api/admin/users/${uid}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ password }),
        });
        if (res.ok) {
          alert('¡Contraseña actualizada con éxito!');
          modalPwd.close();
        } else {
          const err = await res.json();
          alert('Error al actualizar contraseña: ' + (err.error || 'Desconocido'));
        }
      } catch {
        alert('Error de conexión');
      }
    });
  </script>
</Layout>
