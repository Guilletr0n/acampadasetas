---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Admin - Sections">
  <link rel="stylesheet" href="https://unpkg.com/easymde/dist/easymde.min.css">
  
  <div class="drawer lg:drawer-open">
    <input id="admin-drawer" type="checkbox" class="drawer-toggle" />
    <div class="drawer-content flex flex-col items-center justify-start p-8">
      <div class="w-full max-w-6xl flex justify-between items-center mb-8">
        <label for="admin-drawer" class="btn btn-primary drawer-button lg:hidden">Menu</label>
        <h1 class="text-4xl font-brand text-brand-primary">Section Management</h1>
      </div>

      <div class="w-full max-w-6xl bg-base-100 rounded-box shadow p-6">
        <div class="form-control mb-4">
          <label class="label"><span class="label-text">Select Section</span></label>
          <select id="section-selector" class="select select-bordered w-full">
            <option value="new">-- Create New Section --</option>
            <!-- Loaded via JS -->
          </select>
        </div>

        <form id="section-form" class="space-y-4">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="form-control">
              <label class="label"><span class="label-text">Title</span></label>
              <input type="text" id="title" class="input input-bordered w-full" required />
            </div>
            <div class="form-control">
              <label class="label"><span class="label-text">Template</span></label>
              <select id="template" class="select select-bordered w-full">
                <option value="single-column">Single Column</option>
                <option value="multi-column">Multi Column</option>
              </select>
            </div>
          </div>
          
          <div class="form-control">
            <label class="label"><span class="label-text">Subtitle</span></label>
            <input type="text" id="subtitle" class="input input-bordered w-full" />
          </div>
          
          <div class="form-control">
            <label class="label"><span class="label-text">Highlight</span></label>
            <input type="text" id="highlight" class="input input-bordered w-full" />
          </div>

          <div class="form-control">
            <label class="label"><span class="label-text">Illustration</span></label>
            <input type="file" id="illustration" class="file-input file-input-bordered w-full" accept="image/png, image/jpeg, image/webp" />
            <div id="illustration-preview" class="mt-2 text-sm text-gray-500"></div>
          </div>
          
          <div class="form-control">
            <label class="label"><span class="label-text">Body Content (Markdown)</span></label>
            <textarea id="markdown-editor"></textarea>
          </div>
          
          <div class="flex gap-4 pt-4">
            <button type="button" id="save-draft" class="btn btn-outline">Save Draft</button>
            <button type="button" id="publish" class="btn btn-primary">Publish</button>
          </div>
        </form>

        <div class="divider">Version History</div>
        <div class="overflow-x-auto">
          <table class="table w-full">
            <thead>
              <tr>
                <th>Date</th>
                <th>Author</th>
                <th>Template</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody id="history-table">
              <!-- Loaded via JS -->
            </tbody>
          </table>
        </div>
      </div>
    </div> 
    
    <div class="drawer-side">
      <label for="admin-drawer" class="drawer-overlay"></label> 
      <ul class="menu p-4 w-80 min-h-full bg-base-200 text-base-content">
        <li class="mb-4"><h2 class="text-2xl font-brand text-brand-primary">Backoffice</h2></li>
        <li><a href="/admin/sections" class="active">Sections</a></li>
        <li><a href="/admin/gallery">Gallery</a></li>
        <li><a href="/admin/users">Users</a></li>
        <li class="mt-auto"><a href="/logout">Logout</a></li>
      </ul>
    </div>
  </div>

  <script is:inline src="https://unpkg.com/easymde/dist/easymde.min.js"></script>
  <script>
    import { db } from "../../lib/firebase/client";
    import { collection, getDocs, doc, getDoc, setDoc, addDoc, query, orderBy } from "firebase/firestore";

    let easyMDE: any;
    let currentSectionId = "new";
    let illustrationUrl = "";

    document.addEventListener("DOMContentLoaded", async () => {
      // @ts-ignore
      easyMDE = new EasyMDE({ element: document.getElementById("markdown-editor") });
      await loadSections();
    });

    const loadSections = async () => {
      const q = query(collection(db, "sections"), orderBy("order"));
      const snap = await getDocs(q);
      const selector = document.getElementById("section-selector") as HTMLSelectElement;
      
      selector.innerHTML = '<option value="new">-- Create New Section --</option>';
      snap.forEach(doc => {
        const option = document.createElement("option");
        option.value = doc.id;
        option.textContent = doc.data().draft?.title || doc.data().live?.title || doc.id;
        selector.appendChild(option);
      });
    };

    document.getElementById("section-selector")?.addEventListener("change", async (e: any) => {
      currentSectionId = e.target.value;
      if (currentSectionId === "new") {
        (document.getElementById("section-form") as HTMLFormElement).reset();
        easyMDE.value("");
        illustrationUrl = "";
        return;
      }

      const docRef = doc(db, "sections", currentSectionId);
      const docSnap = await getDoc(docRef);
      if (docSnap.exists()) {
        const data = docSnap.data().draft || docSnap.data().live || {};
        
        (document.getElementById("title") as HTMLInputElement).value = data.title || "";
        (document.getElementById("subtitle") as HTMLInputElement).value = data.subtitle || "";
        (document.getElementById("highlight") as HTMLInputElement).value = data.highlight || "";
        (document.getElementById("template") as HTMLSelectElement).value = data.template || "single-column";
        easyMDE.value(data.body || "");
        illustrationUrl = data.illustrationUrl || "";
        
        loadHistory(currentSectionId);
      }
    });

    const loadHistory = async (sectionId: string) => {
      const q = query(collection(db, `sections/${sectionId}/history`), orderBy("timestamp", "desc"));
      const snap = await getDocs(q);
      const tbody = document.getElementById("history-table");
      if (!tbody) return;
      
      tbody.innerHTML = "";
      snap.forEach(historyDoc => {
        const data = historyDoc.data();
        const tr = document.createElement("tr");
        tr.innerHTML = `
          <td>${new Date(data.timestamp).toLocaleString()}</td>
          <td>${data.authorName || 'Unknown'}</td>
          <td>${data.template}</td>
          <td><button class="btn btn-xs btn-outline restore-btn" data-id="${historyDoc.id}">Restore to Draft</button></td>
        `;
        tbody.appendChild(tr);
      });
      
      document.querySelectorAll('.restore-btn').forEach(btn => {
        btn.addEventListener('click', async (e: any) => {
          const hid = e.target.dataset.id;
          const hSnap = await getDoc(doc(db, `sections/${sectionId}/history`, hid));
          if(hSnap.exists()) {
            const hData = hSnap.data();
            (document.getElementById("title") as HTMLInputElement).value = hData.title || "";
            (document.getElementById("subtitle") as HTMLInputElement).value = hData.subtitle || "";
            easyMDE.value(hData.body || "");
            alert("Restored to draft. Click Save Draft to persist.");
          }
        });
      });
    };

    const getFormData = () => ({
      title: (document.getElementById("title") as HTMLInputElement).value,
      subtitle: (document.getElementById("subtitle") as HTMLInputElement).value,
      highlight: (document.getElementById("highlight") as HTMLInputElement).value,
      template: (document.getElementById("template") as HTMLSelectElement).value,
      body: easyMDE.value(),
      illustrationUrl
    });

    document.getElementById("save-draft")?.addEventListener("click", async () => {
      const data = getFormData();
      const slug = data.title.toLowerCase().replace(/\s+/g, '-');
      
      if (currentSectionId === "new") {
        currentSectionId = slug;
      }
      
      const docRef = doc(db, "sections", currentSectionId);
      await setDoc(docRef, { slug, draft: data }, { merge: true });
      alert("Draft saved!");
      loadSections();
    });

    document.getElementById("publish")?.addEventListener("click", async () => {
      const data = getFormData();
      const slug = data.title.toLowerCase().replace(/\s+/g, '-');
      
      if (currentSectionId === "new") {
        currentSectionId = slug;
      }

      const docRef = doc(db, "sections", currentSectionId);
      await setDoc(docRef, { slug, live: data, draft: data }, { merge: true });
      
      // Add to history
      await addDoc(collection(db, `sections/${currentSectionId}/history`), {
        ...data,
        timestamp: new Date().toISOString(),
      });
      
      alert("Published successfully!");
      loadHistory(currentSectionId);
    });

    // Upload handling
    document.getElementById("illustration")?.addEventListener("change", async (e: any) => {
      const file = e.target.files[0];
      if (!file) return;

      const formData = new FormData();
      formData.append("file", file);

      try {
        const res = await fetch("/api/upload", { method: "POST", body: formData });
        const data = await res.json();
        if (data.url) {
          illustrationUrl = data.url;
          (document.getElementById("illustration-preview") as HTMLDivElement).innerText = "Uploaded: " + data.url;
        }
      } catch (err) {
        alert("Upload failed.");
      }
    });
  </script>
</Layout>
