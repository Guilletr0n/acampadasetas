---
import Layout from "../../layouts/Layout.astro";
import AdminNav from "../../components/AdminNav.astro";
import { getGalleryItems } from "../../lib/db";
import { getCurrentUser } from "../../lib/auth";
import { Eye, Plus, Trash2, Save, Check } from "lucide-astro";

export const prerender = false;

const currentUser = await getCurrentUser(Astro.cookies);
if (!currentUser || !currentUser.approved) {
  return Astro.redirect("/login");
}

const items = await getGalleryItems();
---

<Layout title="Gestión de Galería | CMS" isDashboard={true}>
  <AdminNav activeTab="gallery" user={currentUser} />

  <main class="max-w-6xl mx-auto p-6">
    <div
      class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6"
    >
      <div>
        <h1 class="text-4xl font-londrina text-neutral">GALERÍA FOTOGRÁFICA</h1>
        <p class="text-xs text-base-content/70">
          Gestión de imágenes, créditos de autoría, enlaces sociales y orden del
          carrusel.
        </p>
      </div>

      <a
        href="/gallery"
        target="_blank"
        class="btn btn-sm btn-outline inline-flex items-center gap-1.5"
      >
        <Eye class="w-4 h-4" />
        <span>Ver Galería Pública</span>
      </a>
    </div>

    <!-- Upload Card -->
    <div class="card bg-base-100 shadow mb-8">
      <div class="card-body p-6">
        <h2 class="text-2xl font-londrina text-neutral mb-4">
          AÑADIR NUEVA FOTOGRAFÍA
        </h2>

        <form id="gallery-upload-form" class="space-y-4">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="form-control">
              <label class="label" for="photo-file">
                <span class="label-text font-bold text-xs"
                  >ARCHIVO DE IMAGEN (PNG, JPG, WebP menor o igual a 5 MB)</span
                >
              </label>
              <input
                type="file"
                id="photo-file"
                accept="image/png, image/jpeg, image/webp"
                class="file-input file-input-bordered w-full"
              />
            </div>

            <div class="form-control">
              <label class="label" for="photo-url">
                <span class="label-text font-bold text-xs">O URL DIRECTA</span>
              </label>
              <input
                type="url"
                id="photo-url"
                placeholder="https://..."
                class="input input-bordered w-full font-mono text-xs"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="form-control">
              <label class="label" for="caption">
                <span class="label-text font-bold text-xs"
                  >PIE DE FOTO / DESCRIPCIÓN</span
                >
              </label>
              <input
                type="text"
                id="caption"
                placeholder="Ej: Vista de la asamblea vecinal"
                class="input input-bordered w-full"
                required
              />
            </div>

            <div class="form-control">
              <label class="label" for="author">
                <span class="label-text font-bold text-xs"
                  >AUTORÍA / FOTÓGRAFA</span
                >
              </label>
              <input
                type="text"
                id="author"
                placeholder="Ej: Lucía Méndez"
                class="input input-bordered w-full"
                required
              />
            </div>

            <div class="form-control">
              <label class="label" for="social">
                <span class="label-text font-bold text-xs"
                  >ENLACE SOCIAL / PERFIL (OPCIONAL)</span
                >
              </label>
              <input
                type="url"
                id="social"
                placeholder="https://instagram.com/..."
                class="input input-bordered w-full text-xs font-mono"
              />
            </div>
          </div>

          <div class="flex justify-between items-center pt-2">
            <span
              id="upload-status"
              class="text-xs font-semibold text-base-content/70"></span>
            <button
              type="submit"
              id="btn-upload"
              class="btn btn-primary inline-flex items-center gap-1.5"
            >
              <Plus class="w-4 h-4" />
              <span>Añadir a la Galería</span>
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Gallery Grid with Inline Edits -->
    <div class="card bg-base-100 shadow">
      <div class="card-body p-6">
        <h2 class="text-2xl font-londrina text-neutral mb-4">
          FOTOGRAFÍAS ACTIVAS ({items.length})
        </h2>

        {
          items.length === 0 ? (
            <p class="text-center py-8 text-base-content/40">
              No hay fotografías añadidas todavía.
            </p>
          ) : (
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {items.map((img) => (
                <div 
                  class="card bg-base-100 border border-base-200 overflow-hidden shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow photo-card"
                  data-card-id={img.id}
                >
                  <div class="relative bg-neutral-900 h-48 flex items-center justify-center overflow-hidden">
                    <img
                      src={img.url}
                      alt={img.caption}
                      class="w-full h-full object-cover photo-preview-img"
                      data-id={img.id}
                    />
                    <span 
                      class="absolute top-2 left-2 badge badge-neutral text-xs font-mono photo-order-badge"
                      data-id={img.id}
                    >
                      #{img.order}
                    </span>
                  </div>

                  <div class="p-4 space-y-3 flex-1">
                    <div>
                      <label class="text-[10px] uppercase font-bold text-base-content/60 block mb-1">
                        Pie de foto / Descripción
                      </label>
                      <input
                        type="text"
                        value={img.caption}
                        placeholder="Descripción o pie de foto..."
                        class="input input-bordered input-sm w-full font-semibold photo-input-caption"
                        data-id={img.id}
                      />
                    </div>

                    <div class="grid grid-cols-2 gap-2">
                      <div>
                        <label class="text-[10px] uppercase font-bold text-base-content/60 block mb-1">
                          Fotógrafa / Autoría
                        </label>
                        <input
                          type="text"
                          value={img.author}
                          placeholder="Autoría..."
                          class="input input-bordered input-sm w-full photo-input-author"
                          data-id={img.id}
                        />
                      </div>
                      <div>
                        <label class="text-[10px] uppercase font-bold text-base-content/60 block mb-1">
                          Orden
                        </label>
                        <input
                          type="number"
                          value={img.order}
                          min="1"
                          class="input input-bordered input-sm w-full photo-input-order font-mono"
                          data-id={img.id}
                        />
                      </div>
                    </div>

                    <div>
                      <label class="text-[10px] uppercase font-bold text-base-content/60 block mb-1">
                        Enlace Social / Perfil
                      </label>
                      <input
                        type="url"
                        value={img.social || ""}
                        placeholder="https://instagram.com/..."
                        class="input input-bordered input-sm w-full font-mono text-xs photo-input-social"
                        data-id={img.id}
                      />
                    </div>

                    <div>
                      <label class="text-[10px] uppercase font-bold text-base-content/60 block mb-1">
                        URL directa de la imagen
                      </label>
                      <input
                        type="url"
                        value={img.url}
                        placeholder="https://..."
                        class="input input-bordered input-xs w-full font-mono text-[10px] text-base-content/70 photo-input-url"
                        data-id={img.id}
                      />
                    </div>
                  </div>

                  <div class="p-3 bg-base-200/50 border-t border-base-200 flex justify-between items-center gap-2">
                    <span class="text-[10px] text-base-content/50 font-mono">
                      {new Date(img.createdAt).toLocaleDateString("es-ES")}
                    </span>
                    <div class="flex items-center gap-2">
                      <button
                        type="button"
                        class="btn btn-xs btn-primary save-img-btn inline-flex items-center gap-1 font-semibold"
                        data-id={img.id}
                        title="Guardar cambios de esta fotografía"
                      >
                        <Save class="w-3.5 h-3.5" />
                        <span>Guardar</span>
                      </button>
                      <div class="tooltip tooltip-left" data-tip="Eliminar">
                        <button
                          type="button"
                          class="btn btn-xs btn-error delete-img-btn"
                          data-id={img.id}
                          aria-label="Eliminar"
                        >
                          <Trash2 class="w-3.5 h-3.5 pointer-events-none" />
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          )
        }
      </div>
    </div>
  </main>

  <script is:inline>
    // Upload form
    const form = document.getElementById("gallery-upload-form");
    const photoFile = document.getElementById("photo-file");
    const photoUrl = document.getElementById("photo-url");
    const uploadStatus = document.getElementById("upload-status");
    const btnUpload = document.getElementById("btn-upload");

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      uploadStatus.innerText = "Procesando imagen...";
      btnUpload.disabled = true;

      let finalUrl = photoUrl.value.trim();

      // If file selected, upload first
      if (photoFile.files && photoFile.files[0]) {
        const formData = new FormData();
        formData.append("file", photoFile.files[0]);

        try {
          const uploadRes = await fetch("/api/upload", {
            method: "POST",
            body: formData,
          });
          const uploadData = await uploadRes.json();
          if (uploadRes.ok && uploadData.url) {
            finalUrl = uploadData.url;
          } else {
            alert(uploadData.error || "Error al subir imagen");
            uploadStatus.innerText = "";
            btnUpload.disabled = false;
            return;
          }
        } catch {
          alert("Error de conexión al subir imagen");
          uploadStatus.innerText = "";
          btnUpload.disabled = false;
          return;
        }
      }

      if (!finalUrl) {
        alert("Debes seleccionar un archivo o indicar una URL");
        uploadStatus.innerText = "";
        btnUpload.disabled = false;
        return;
      }

      const caption = document.getElementById("caption").value.trim();
      const author = document.getElementById("author").value.trim();
      const social = document.getElementById("social").value.trim();

      try {
        const res = await fetch("/api/admin/gallery", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            url: finalUrl,
            caption,
            author,
            social,
            order: document.querySelectorAll(".delete-img-btn").length + 1,
          }),
        });

        if (res.ok) {
          uploadStatus.innerText = "Fotografía añadida con éxito";
          setTimeout(() => window.location.reload(), 800);
        } else {
          alert("Error al guardar en galería");
          btnUpload.disabled = false;
        }
      } catch {
        alert("Error de conexión");
        btnUpload.disabled = false;
      }
    });

    // Save individual photo changes
    document.querySelectorAll(".save-img-btn").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const id = btn.dataset.id;
        if (!id) return;

        const card = btn.closest(".photo-card") || document.querySelector(`.photo-card[data-card-id="${id}"]`);
        if (!card) return;

        const captionInput = card.querySelector(".photo-input-caption");
        const authorInput = card.querySelector(".photo-input-author");
        const orderInput = card.querySelector(".photo-input-order");
        const socialInput = card.querySelector(".photo-input-social");
        const urlInput = card.querySelector(".photo-input-url");

        const caption = captionInput ? captionInput.value.trim() : "";
        const author = authorInput ? authorInput.value.trim() : "";
        const order = orderInput ? (parseInt(orderInput.value, 10) || 1) : 1;
        const social = socialInput ? socialInput.value.trim() : "";
        const url = urlInput ? urlInput.value.trim() : "";

        const originalContent = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<span class="loading loading-spinner loading-xs"></span> Guardando...';

        try {
          const res = await fetch("/api/admin/gallery", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              id,
              caption,
              author,
              order,
              social,
              url,
            }),
          });

          const data = await res.json().catch(() => ({}));
          if (!res.ok) {
            throw new Error(data.error || "Error al guardar cambios");
          }

          // Update order badge on photo preview
          const badge = card.querySelector(".photo-order-badge");
          if (badge) badge.textContent = `#${order}`;

          // Update preview image if url was changed
          if (url) {
            const previewImg = card.querySelector(".photo-preview-img");
            if (previewImg) previewImg.src = url;
          }

          // Visual feedback on button
          btn.classList.remove("btn-primary");
          btn.classList.add("btn-success", "text-white");
          btn.innerHTML = '<span>✓ ¡Guardado!</span>';

          setTimeout(() => {
            btn.disabled = false;
            btn.classList.remove("btn-success", "text-white");
            btn.classList.add("btn-primary");
            btn.innerHTML = originalContent;
          }, 2000);
        } catch (err) {
          alert("Error al guardar: " + (err.message || "Desconocido"));
          btn.disabled = false;
          btn.innerHTML = originalContent;
        }
      });
    });

    // Enter key submits the card's save action
    document.querySelectorAll(".photo-card input").forEach((input) => {
      input.addEventListener("keydown", (e) => {
        if (e.key === "Enter") {
          e.preventDefault();
          const card = input.closest(".photo-card");
          const saveBtn = card ? card.querySelector(".save-img-btn") : null;
          if (saveBtn && !saveBtn.disabled) saveBtn.click();
        }
      });
    });

    // Delete item
    document.querySelectorAll(".delete-img-btn").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const id = btn.dataset.id || btn.getAttribute("data-id");
        if (!id) {
          alert("Identificador de fotografía no encontrado.");
          return;
        }

        if (confirm("¿Eliminar esta fotografía de la galería? Esta acción no se puede deshacer.")) {
          const originalContent = btn.innerHTML;
          btn.disabled = true;
          btn.innerHTML = '<span class="loading loading-spinner loading-xs"></span>';

          try {
            const res = await fetch(`/api/admin/gallery?id=${encodeURIComponent(id)}`, {
              method: "DELETE",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ id }),
            });

            const data = await res.json().catch(() => ({}));
            if (res.ok && data.success) {
              const card = btn.closest(".photo-card") || document.querySelector(`.photo-card[data-card-id="${id}"]`);
              if (card) {
                card.style.transition = "all 0.35s ease";
                card.style.opacity = "0";
                card.style.transform = "scale(0.95)";
                setTimeout(() => {
                  card.remove();
                  window.location.reload();
                }, 350);
              } else {
                window.location.reload();
              }
            } else {
              alert(data.error || "Error al eliminar fotografía");
              btn.disabled = false;
              btn.innerHTML = originalContent;
            }
          } catch {
            alert("Error de conexión al eliminar fotografía");
            btn.disabled = false;
            btn.innerHTML = originalContent;
          }
        }
      });
    });
  </script>
</Layout>
