---
import Layout from "../layouts/Layout.astro";
import { getSections } from "../lib/db";
import { marked } from "marked";

export const prerender = false;

const sections = await getSections(true); // true = live published sections only
---

<Layout title="Acampada Setas Sevilla | Movilización por la Vivienda">
  <!-- Sticky Navigation Header -->
  <header
    class="sticky top-0 z-50 bg-[#fcf2df]/95 backdrop-blur-md border-b border-black/10 px-4 md:px-8 py-3 transition-all shadow-sm"
  >
    <div class="max-w-6xl mx-auto flex items-center justify-between">
      <a href="#" class="flex items-center gap-2 group">
        <span
          class="text-3xl md:text-4xl font-londrina text-[#af0b56] tracking-wide group-hover:scale-105 transition-transform"
        >
          ACAMPADA SETAS
        </span>
      </a>

      <!-- Desktop Nav -->
      <nav
        class="hidden md:flex items-center gap-6 font-bold text-sm text-[#1d1d1b]"
      >
        {
          sections.map((sec) => (
            <a
              href={`#${sec.slug}`}
              class="hover:text-[#af0b56] uppercase tracking-wider transition-colors scroll-link"
            >
              {sec.live?.title || sec.slug}
            </a>
          ))
        }
        <a
          href="/gallery"
          class="hover:text-[#af0b56] uppercase tracking-wider transition-colors text-[#af0b56]"
        >
          Galería
        </a>
        <a href="/login" class="btn btn-sm btn-outline font-mono text-xs">
          CMS
        </a>
      </nav>

      <!-- Mobile dropdown -->
      <div class="dropdown dropdown-end md:hidden">
        <label tabindex="0" class="btn btn-ghost btn-sm">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-6 w-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </label>
        <ul
          tabindex="0"
          class="dropdown-content menu p-2 shadow-lg bg-[#fcf2df] border border-black/10 rounded-box w-52 text-sm font-bold mt-2"
        >
          {
            sections.map((sec) => (
              <li>
                <a
                  href={`#${sec.slug}`}
                  class="uppercase text-[#1d1d1b] hover:text-[#af0b56]"
                >
                  {sec.live?.title || sec.slug}
                </a>
              </li>
            ))
          }
          <li class="border-t border-black/10 mt-1 pt-1">
            <a href="/gallery" class="text-[#af0b56]">Galería Oscura</a>
          </li>
          <li>
            <a href="/login" class="text-gray-700">Acceso CMS</a>
          </li>
        </ul>
      </div>
    </div>
  </header>

  <!-- Hero / Intro Banner -->
  <section
    class="py-12 md:py-20 px-4 max-w-6xl mx-auto text-center border-b border-black/10"
  >
    <div
      class="inline-block bg-[#af0b56] text-white px-4 py-1 text-sm md:text-base font-bold uppercase tracking-widest rounded-full mb-4 shadow-sm"
    >
      Plaza de la Encarnación • Sevilla
    </div>
    <h1
      class="text-6xl md:text-8xl font-londrina text-[#1d1d1b] leading-none mb-6"
    >
      POR EL DERECHO A LA CIUDAD Y A LA VIVIENDA
    </h1>
    <p
      class="max-w-2xl mx-auto text-lg md:text-xl text-[#1d1d1b] font-medium leading-relaxed"
    >
      Frente a la especulación rentista, los desahucios y la turistificación
      masiva: autoorganización popular y asamblea abierta permanente.
    </p>
    <div class="flex flex-wrap justify-center gap-4 mt-8">
      <a href="#manifiesto" class="btn btn-primary px-6 text-base">
        Leer Manifiesto
      </a>
      <a href="#agenda" class="btn btn-outline px-6 text-base">
        Ver Programa de Actividades
      </a>
      <a href="/gallery" class="btn btn-outline btn-primary px-6 text-base">
        Galería de Fotos
      </a>
    </div>
  </section>

  <!-- Dynamic Sections Rendered by Template -->
  <main class="space-y-0">
    {
      sections.length === 0 ? (
        <div class="py-20 text-center text-gray-500">
          <p class="text-xl font-bold">
            No hay secciones publicadas actualmente.
          </p>
          <p class="text-sm mt-1">
            Inicia sesión en el{" "}
            <a href="/login" class="underline text-[#af0b56]">
              CMS
            </a>{" "}
            para redactar y publicar contenidos.
          </p>
        </div>
      ) : (
        sections.map((sec, index) => {
          const content = sec.live;
          if (!content) return null;

          const renderedMarkdown = marked.parse(content.body || "");
          const isAlternate = index % 2 === 1;

          // TEMPLATE 1: MULTI-COLUMN (e.g., Agenda / Activity Schedule)
          if (content.template === "multi-column") {
            return (
              <section
                id={sec.slug}
                class={`py-16 md:py-24 px-4 border-b border-black/10 ${isAlternate ? "bg-[#f7e9d0]" : "bg-[#fcf2df]"}`}
              >
                <div class="max-w-6xl mx-auto">
                  <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-4 mb-10 pb-4 border-b border-black/10">
                    <div>
                      {content.highlight && (
                        <span class="inline-block bg-[#af0b56] text-white text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full mb-2 shadow-sm">
                          {content.highlight}
                        </span>
                      )}
                      <h2 class="text-5xl md:text-6xl font-londrina text-[#1d1d1b] m-0">
                        {content.title}
                      </h2>
                      {content.subtitle && (
                        <p class="text-lg md:text-xl text-gray-700 font-medium mt-1">
                          {content.subtitle}
                        </p>
                      )}
                    </div>
                    <a
                      href={`#${sec.slug}`}
                      class="text-xs font-mono font-bold text-gray-400 hover:text-black"
                    >
                      #{sec.slug}
                    </a>
                  </div>

                  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
                    <div
                      class={`prose max-w-none text-[#1d1d1b] ${content.illustrationUrl ? "lg:col-span-7" : "lg:col-span-12"}`}
                    >
                      <div
                        class="space-y-4 text-base md:text-lg leading-relaxed"
                        set:html={renderedMarkdown}
                      />
                    </div>

                    {content.illustrationUrl && (
                      <div class="lg:col-span-5 sticky top-24">
                        <div class="rounded-2xl overflow-hidden bg-white shadow-md">
                          <img
                            src={content.illustrationUrl}
                            alt={content.title}
                            class="w-full h-auto object-cover max-h-[420px]"
                            loading="lazy"
                          />
                        </div>
                      </div>
                    )}
                  </div>
                </div>
              </section>
            );
          }

          // TEMPLATE 2: SINGLE-COLUMN (e.g., Manifiesto / Centered focus layout)
          return (
            <section
              id={sec.slug}
              class={`py-16 md:py-24 px-4 border-b border-black/10 ${isAlternate ? "bg-[#f7e9d0]" : "bg-[#fcf2df]"}`}
            >
              <div class="max-w-4xl mx-auto text-center">
                {content.highlight && (
                  <div class="inline-block bg-[#af0b56] text-white text-xs md:text-sm font-bold uppercase tracking-wider px-4 py-1 rounded-full mb-4 shadow-sm">
                    {content.highlight}
                  </div>
                )}

                <h2 class="text-5xl md:text-7xl font-londrina text-[#1d1d1b] mb-3 leading-tight">
                  {content.title}
                </h2>

                {content.subtitle && (
                  <p class="text-xl md:text-2xl text-gray-700 font-medium mb-8 max-w-2xl mx-auto">
                    {content.subtitle}
                  </p>
                )}

                {content.illustrationUrl && (
                  <div class="my-8 max-w-2xl mx-auto rounded-2xl overflow-hidden shadow-md bg-white">
                    <img
                      src={content.illustrationUrl}
                      alt={content.title}
                      class="w-full h-auto object-cover max-h-[400px]"
                      loading="lazy"
                    />
                  </div>
                )}

                <div class="prose max-w-none text-left text-base md:text-lg leading-relaxed bg-white/80 p-6 md:p-10 rounded-2xl shadow-sm border border-black/5 mt-6">
                  <div set:html={renderedMarkdown} />
                </div>
              </div>
            </section>
          );
        })
      )
    }
  </main>

  <!-- Footer -->
  <footer
    class="bg-[#1d1d1b] text-[#fcf2df] py-12 px-4 border-t-4 border-[#af0b56]"
  >
    <div
      class="max-w-6xl mx-auto flex flex-col md:flex-row justify-between items-center gap-6 text-center md:text-left"
    >
      <div>
        <h3 class="text-3xl font-londrina text-[#af0b56] tracking-wide">
          ACAMPADA SETAS SEVILLA
        </h3>
        <p class="text-xs text-gray-400 mt-1">
          Contacto: [EMAIL_ADDRESS] • Instagram: @acampadasetas
        </p>
      </div>

      <div class="flex items-center gap-4 text-sm font-bold">
        <a href="/gallery" class="hover:text-[#af0b56] transition-colors"
          >Galería Fotográfica</a
        >
        <span>•</span>
        <a href="/join-editor" class="hover:text-[#af0b56] transition-colors"
          >Postularse como Editora</a
        >
        <span>•</span>
        <a href="/login" class="hover:text-[#af0b56] transition-colors"
          >Acceso CMS</a
        >
      </div>
    </div>
  </footer>
</Layout>

<style>
  html {
    scroll-behavior: smooth;
  }
</style>
