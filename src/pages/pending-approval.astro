---
import Layout from "../layouts/Layout.astro";
import { getCurrentUser } from "../lib/auth";

export const prerender = false;

const user = await getCurrentUser(Astro.cookies);
---

<Layout title="Cuenta Pendiente de Aprobación" isDashboard={true}>
  <main class="min-h-screen flex items-center justify-center p-4 bg-base-200">
    <div class="card w-full max-w-md bg-base-100 shadow-xl text-center p-6">
      <h2 class="text-3xl font-londrina text-primary">CUENTA EN REVISIÓN</h2>
      <p class="text-sm text-base-content/80 mt-2">
        Hola <strong>{user?.displayName || 'compañera'}</strong>, tu cuenta ({user?.email}) está registrada correctamente con rol de <strong>lectora</strong> y en estado <strong>pendiente de aprobación</strong>.
      </p>
      <p class="text-xs text-base-content/60 mt-3">
        Un administrador debe validar tu solicitud desde el panel de gestión para habilitar tus permisos de edición en el CMS.
      </p>

      <div class="flex justify-center gap-3 mt-6">
        <a href="/" class="btn btn-outline btn-sm">Ver la Web</a>
        <a href="/api/auth/logout" class="btn btn-primary btn-sm">Cerrar Sesión</a>
      </div>
    </div>
  </main>
</Layout>
