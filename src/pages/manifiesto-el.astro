---
import ManifestoView from "../components/ManifestoView.astro";

export const prerender = false;

// Actualizar cookie de preferencia para que recuerde que eligió griego
Astro.cookies.set("preferred_lang", "el", {
  path: "/",
  maxAge: 60 * 60 * 24 * 365,
  sameSite: "lax",
});
---

<ManifestoView lang="el" />
