---
import Layout from "../layouts/Layout.astro";
import { getGalleryItems } from "../lib/db";
import { ArrowLeft, SlidersHorizontal, ChevronLeft, ChevronRight } from "lucide-astro";

export const prerender = false;

const items = await getGalleryItems();
---

<Layout title="Galería Fotográfica Oscura | Acampada Setas" theme="dark">
  <div class="relative w-screen h-screen h-[100dvh] overflow-hidden bg-black text-neutral-content select-none">
    <!-- Header (aparece solo cuando se mueve el ratón) -->
    <header
      id="gallery-header"
      class="fixed top-0 inset-x-0 z-50 px-4 md:px-8 py-3 md:py-4 bg-gradient-to-b from-black/85 via-black/40 to-transparent transition-opacity duration-300 opacity-100 pointer-events-auto"
    >
      <div class="max-w-7xl mx-auto flex items-center justify-between">
        <a
          href="/"
          class="flex items-center gap-2 group text-[#af0b56] hover:opacity-80 transition-opacity"
        >
          <ArrowLeft class="w-5 h-5 text-white group-hover:text-[#af0b56] transition-colors" />
          <span class="text-2xl md:text-3xl font-londrina tracking-wider text-white group-hover:text-[#af0b56] transition-colors drop-shadow">
            ACAMPADA SETAS
          </span>
        </a>

        <div class="flex items-center gap-3 md:gap-4">
          <span class="badge badge-outline text-xs font-mono text-neutral-300 border-neutral-600 bg-black/40 backdrop-blur-sm">
            {items.length} {items.length === 1 ? 'Fotografía' : 'Fotografías'}
          </span>
          <a
            href="/admin/gallery"
            class="btn btn-xs btn-outline border-neutral-600 bg-black/40 backdrop-blur-sm text-neutral-200 hover:bg-neutral-800 hover:text-white inline-flex items-center gap-1.5"
          >
            <SlidersHorizontal class="w-3.5 h-3.5" />
            <span>Gestionar</span>
          </a>
        </div>
      </div>
    </header>

    <!-- Main Carousel Section (Ocupa toda la pantalla) -->
    <main class="w-full h-full relative">
      {items.length === 0 ? (
        <div class="w-full h-full flex flex-col items-center justify-center text-center p-6 text-neutral-400">
          <p class="text-3xl md:text-4xl font-londrina text-white">No hay fotografías disponibles en la galería.</p>
          <p class="text-sm mt-2 text-neutral-400">Accede al panel de control para subir imágenes.</p>
          <a href="/admin/gallery" class="btn btn-sm btn-outline border-neutral-700 text-white hover:bg-neutral-800 mt-6 inline-flex items-center gap-2">
            <SlidersHorizontal class="w-4 h-4" />
            Gestionar Galería
          </a>
        </div>
      ) : (
        <div class="w-full h-full relative">
          <!-- DaisyUI Touch-friendly Fullscreen Carousel -->
          <div
            id="gallery-carousel"
            class="carousel w-full h-full overflow-x-auto scroll-smooth snap-x snap-mandatory [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden"
          >
            {items.map((img, index) => {
              const prevIndex = index === 0 ? items.length - 1 : index - 1;
              const nextIndex = index === items.length - 1 ? 0 : index + 1;

              return (
                <div
                  id={`slide-${index}`}
                  data-index={index}
                  class="carousel-item relative w-full h-full flex items-center justify-center bg-black shrink-0 snap-start"
                >
                  <!-- Photo image (toda la pantalla) -->
                  <div class="w-full h-full flex items-center justify-center bg-black">
                    <img
                      src={img.url}
                      alt={img.caption || `Fotografía ${index + 1} de la Acampada`}
                      class="w-full h-full object-contain select-none"
                      loading={index === 0 ? "eager" : "lazy"}
                      fetchpriority={index === 0 ? "high" : "auto"}
                      draggable="false"
                    />
                  </div>

                  <!-- Gradient overlay at bottom for controls/text contrast -->
                  <div class="absolute inset-x-0 bottom-0 h-52 bg-gradient-to-t from-black/85 via-black/40 to-transparent pointer-events-none z-10" />

                  <!-- Caption & Attribution Overlay (Capa superior sobre la foto) -->
                  <div class="absolute bottom-20 md:bottom-24 inset-x-0 z-30 px-6 md:px-12 flex flex-col md:flex-row justify-between items-start md:items-end gap-3 pointer-events-none">
                    <div class="max-w-2xl bg-black/60 backdrop-blur-md px-5 py-3 rounded-xl border border-white/10 pointer-events-auto shadow-xl">
                      {img.caption && (
                        <p class="text-base md:text-xl font-medium text-white tracking-wide">
                          {img.caption}
                        </p>
                      )}
                      <div class="flex items-center gap-2 mt-1 text-xs md:text-sm text-neutral-300">
                        <span>
                          Fotografía por:{" "}
                          {img.social ? (
                            <a
                              href={img.social}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="font-semibold text-white underline decoration-neutral-400 hover:text-[#af0b56] hover:decoration-[#af0b56] transition-colors"
                              title={`Abrir perfil de ${img.author} en otra pestaña`}
                            >
                              {img.author}
                            </a>
                          ) : (
                            <strong class="font-semibold text-white">{img.author}</strong>
                          )}
                        </span>
                      </div>
                    </div>

                    <div class="badge badge-neutral bg-black/60 backdrop-blur-md text-white border-white/20 font-mono text-xs px-3 py-1.5 h-auto leading-normal pointer-events-auto shadow-xl">
                      {index + 1} / {items.length}
                    </div>
                  </div>

                  <!-- Navigation Arrows (Capa superior sobre la foto) -->
                  {items.length > 1 && (
                    <div class="absolute inset-y-0 inset-x-4 md:inset-x-8 z-30 flex justify-between items-center pointer-events-none">
                      <a
                        href={`#slide-${prevIndex}`}
                        class="btn btn-circle btn-sm md:btn-md bg-black/50 backdrop-blur-md border border-white/20 text-white hover:bg-black/90 hover:scale-105 pointer-events-auto shadow-xl transition-transform"
                        aria-label="Foto anterior"
                      >
                        <ChevronLeft class="w-5 h-5" />
                      </a>
                      <a
                        href={`#slide-${nextIndex}`}
                        class="btn btn-circle btn-sm md:btn-md bg-black/50 backdrop-blur-md border border-white/20 text-white hover:bg-black/90 hover:scale-105 pointer-events-auto shadow-xl transition-transform"
                        aria-label="Foto siguiente"
                      >
                        <ChevronRight class="w-5 h-5" />
                      </a>
                    </div>
                  )}
                </div>
              );
            })}
          </div>

          <!-- Thumbnails navigator (Capa superior sobre la foto) -->
          {items.length > 1 && (
            <nav
              aria-label="Navegación de miniaturas"
              class="fixed bottom-7 md:bottom-8 inset-x-0 z-40 flex justify-center gap-2 px-4 overflow-x-auto py-1 pointer-events-auto [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden"
            >
              {items.map((img, idx) => (
                <a
                  href={`#slide-${idx}`}
                  data-thumb-index={idx}
                  class="thumb-item w-10 h-10 md:w-12 md:h-12 rounded-lg border-2 border-white/20 hover:border-[#af0b56] bg-black/40 backdrop-blur-sm overflow-hidden transition-all shrink-0 opacity-60 hover:opacity-100 focus:opacity-100 shadow-lg"
                  title={img.caption || `Fotografía ${idx + 1}`}
                >
                  <img
                    src={img.url}
                    alt=""
                    class="w-full h-full object-cover select-none pointer-events-none"
                    loading="lazy"
                  />
                </a>
              ))}
            </nav>
          )}
        </div>
      )}
    </main>

    <!-- Footer transparente superpuesto a la foto -->
    <footer class="fixed bottom-0 inset-x-0 z-40 py-2 px-4 text-center pointer-events-none bg-transparent">
      <p class="text-[11px] md:text-xs text-neutral-300 drop-shadow-[0_1px_3px_rgba(0,0,0,0.9)] tracking-wide font-normal">
        Archivo visual de la Acampada Setas Sevilla • Todo el material compartido bajo cultura libre
      </p>
    </footer>
  </div>
</Layout>

<script>
  // Control de visibilidad del Header al mover el ratón
  const header = document.getElementById('gallery-header');
  let headerTimer: ReturnType<typeof setTimeout> | undefined;
  let isHoveringHeader = false;

  function resetHeaderTimer() {
    if (headerTimer) clearTimeout(headerTimer);
    headerTimer = setTimeout(() => {
      if (!isHoveringHeader && header) {
        header.classList.remove('opacity-100', 'pointer-events-auto');
        header.classList.add('opacity-0', 'pointer-events-none');
      }
    }, 2500);
  }

  function showHeader() {
    if (!header) return;
    header.classList.remove('opacity-0', 'pointer-events-none');
    header.classList.add('opacity-100', 'pointer-events-auto');
    resetHeaderTimer();
  }

  if (header) {
    header.addEventListener('mouseenter', () => {
      isHoveringHeader = true;
      if (headerTimer) clearTimeout(headerTimer);
      header.classList.remove('opacity-0', 'pointer-events-none');
      header.classList.add('opacity-100', 'pointer-events-auto');
    });

    header.addEventListener('mouseleave', () => {
      isHoveringHeader = false;
      resetHeaderTimer();
    });
  }

  window.addEventListener('mousemove', showHeader);
  window.addEventListener('touchstart', showHeader, { passive: true });

  // Iniciar temporizador tras la carga inicial
  resetHeaderTimer();

  // Gestión de miniaturas activas y teclas de flecha
  const carousel = document.getElementById('gallery-carousel');
  const slides = document.querySelectorAll<HTMLElement>('.carousel-item');
  const thumbs = document.querySelectorAll<HTMLElement>('.thumb-item');

  function setActiveThumb(index: number) {
    thumbs.forEach((thumb, idx) => {
      if (idx === index) {
        thumb.classList.add('border-[#af0b56]', 'opacity-100', 'scale-105', 'ring-2', 'ring-[#af0b56]/40');
        thumb.classList.remove('border-white/20', 'opacity-60');
      } else {
        thumb.classList.remove('border-[#af0b56]', 'opacity-100', 'scale-105', 'ring-2', 'ring-[#af0b56]/40');
        thumb.classList.add('border-white/20', 'opacity-60');
      }
    });
  }

  if (slides.length > 0 && thumbs.length > 0) {
    setActiveThumb(0);

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const indexStr = entry.target.getAttribute('data-index');
            if (indexStr !== null) {
              const activeIndex = parseInt(indexStr, 10);
              setActiveThumb(activeIndex);
            }
          }
        });
      },
      {
        root: carousel,
        threshold: 0.6,
      }
    );

    slides.forEach((slide) => observer.observe(slide));
  }

  // Navegación mediante flechas de teclado
  window.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
      if (!carousel || slides.length === 0) return;
      const scrollPos = carousel.scrollLeft;
      const slideWidth = carousel.clientWidth;
      const currentIndex = Math.round(scrollPos / slideWidth);

      let targetIndex = currentIndex;
      if (e.key === 'ArrowRight') {
        targetIndex = (currentIndex + 1) % slides.length;
      } else if (e.key === 'ArrowLeft') {
        targetIndex = (currentIndex - 1 + slides.length) % slides.length;
      }

      const targetSlide = document.getElementById(`slide-${targetIndex}`);
      if (targetSlide) {
        targetSlide.scrollIntoView({ behavior: 'smooth', inline: 'start', block: 'nearest' });
      }
    }
  });
</script>
