---
import Layout from "../layouts/Layout.astro";
import { getGalleryItems } from "../lib/db";

export const prerender = false;

const items = await getGalleryItems();
---

<Layout title="Galería Fotográfica Oscura | Acampada Setas" theme="dark">
  <div class="min-h-screen bg-neutral-950 text-neutral-content flex flex-col justify-between">
    <!-- Dark Gallery Header -->
    <header class="border-b border-neutral-800 px-6 py-4 bg-black/60 backdrop-blur sticky top-0 z-50">
      <div class="max-w-6xl mx-auto flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 group">
          <span class="text-3xl font-londrina text-[#af0b56] tracking-wider group-hover:opacity-80 transition-opacity">
            ACAMPADA SETAS
          </span>
        </a>

        <div class="flex items-center gap-4">
          <span class="badge badge-outline text-xs font-mono text-neutral-400">
            {items.length} {items.length === 1 ? 'Fotografía' : 'Fotografías'}
          </span>
          <a href="/admin/gallery" class="btn btn-xs btn-outline">
            Gestionar
          </a>
        </div>
      </div>
    </header>

    <!-- Main Carousel Section -->
    <main class="max-w-6xl w-full mx-auto p-4 md:p-8 flex-1 flex flex-col justify-center">
      {items.length === 0 ? (
        <div class="text-center py-20 text-neutral-500">
          <p class="text-2xl font-londrina">No hay fotografías disponibles en la galería.</p>
          <p class="text-sm mt-2">Accede al panel de control para subir imágenes.</p>
        </div>
      ) : (
        <div class="w-full">
          <!-- DaisyUI Touch-friendly Carousel -->
          <div class="carousel w-full rounded-2xl border border-neutral-800 bg-black/80 shadow-2xl overflow-hidden">
            {items.map((img, index) => {
              const prevIndex = index === 0 ? items.length - 1 : index - 1;
              const nextIndex = index === items.length - 1 ? 0 : index + 1;

              return (
                <div id={`slide-${index}`} class="carousel-item relative w-full h-[65vh] md:h-[75vh] flex flex-col justify-between">
                  <!-- Photo image -->
                  <div class="w-full h-full flex items-center justify-center p-2 bg-neutral-950">
                    <img 
                      src={img.url} 
                      alt={img.caption || 'Fotografía de la Acampada'} 
                      class="max-h-full max-w-full object-contain mx-auto select-none rounded"
                      loading="lazy"
                    />
                  </div>

                  <!-- Caption & Attribution Overlay -->
                  <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black via-black/80 to-transparent p-6 md:p-8 flex flex-col md:flex-row justify-between items-start md:items-end gap-3 pointer-events-auto">
                    <div class="max-w-2xl">
                      {img.caption && (
                        <p class="text-lg md:text-2xl font-medium text-white tracking-wide">
                          {img.caption}
                        </p>
                      )}
                      <div class="flex items-center gap-2 mt-1 text-xs md:text-sm text-neutral-400">
                        <span>Fotografía por: <strong class="text-neutral-200">{img.author}</strong></span>
                        {img.social && (
                          <>
                            <span>•</span>
                            <a 
                              href={img.social} 
                              target="_blank" 
                              rel="noopener noreferrer" 
                              class="text-[#af0b56] hover:underline font-bold transition-colors"
                            >
                              Perfil / Red Social
                            </a>
                          </>
                        )}
                      </div>
                    </div>

                    <div class="badge badge-neutral bg-neutral-900 border-neutral-700 font-mono text-xs">
                      {index + 1} / {items.length}
                    </div>
                  </div>

                  <!-- Navigation Arrows -->
                  <div class="absolute inset-y-0 inset-x-4 flex justify-between items-center pointer-events-none">
                    <a 
                      href={`#slide-${prevIndex}`} 
                      class="btn btn-circle btn-sm md:btn-md bg-black/60 border-neutral-700 text-white hover:bg-black pointer-events-auto"
                      aria-label="Anterior"
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                      </svg>
                    </a>
                    <a 
                      href={`#slide-${nextIndex}`} 
                      class="btn btn-circle btn-sm md:btn-md bg-black/60 border-neutral-700 text-white hover:bg-black pointer-events-auto"
                      aria-label="Siguiente"
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                      </svg>
                    </a>
                  </div>
                </div>
              );
            })}
          </div>

          <!-- Thumbnails navigator -->
          <div class="flex justify-center gap-2 mt-6 overflow-x-auto py-2">
            {items.map((img, idx) => (
              <a 
                href={`#slide-${idx}`} 
                class="w-12 h-12 md:w-16 md:h-16 rounded-lg border border-neutral-700 overflow-hidden hover:border-[#af0b56] transition-colors shrink-0 opacity-70 hover:opacity-100"
              >
                <img src={img.url} alt={`Miniatura ${idx + 1}`} class="w-full h-full object-cover" />
              </a>
            ))}
          </div>
        </div>
      )}
    </main>

    <!-- Footer -->
    <footer class="border-t border-neutral-900 py-6 text-center text-xs text-neutral-500">
      <p>Archivo visual de la Acampada Setas Sevilla • Todo el material compartido bajo cultura libre</p>
    </footer>
  </div>
</Layout>
