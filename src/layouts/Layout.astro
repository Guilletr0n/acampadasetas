---
import "../styles/global.css";

interface Props {
  title: string;
  theme?: string;
  isDashboard?: boolean;
}

const { title, theme = "light", isDashboard = false } = Astro.props;
---

<!DOCTYPE html>
<html lang="es" data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Favicons -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />

    <!-- Apple Touch Icon (iOS) -->
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Acampada Setas" />

    <!-- Progressive Web App (PWA) & Mobile Colors -->
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#af0b56" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Google Fonts: Londrina Solid for titles & Poppins for general text -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Londrina+Solid:wght@300;400;900&family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />
    
    <title>{title} | Acampada Setas Sevilla</title>
  </head>
  <body class={isDashboard ? "bg-base-200 min-h-screen text-base-content" : "min-h-screen"}>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --brand-primary: #af0b56;
    --brand-bg: #fcf2df;
    --brand-black: #1d1d1b;
  }

  body {
    font-family: 'Poppins', sans-serif;
  }

  h1, h2, h3, h4, h5, h6, .font-londrina {
    font-family: 'Londrina Solid', cursive, sans-serif;
  }
</style>
