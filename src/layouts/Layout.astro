---
import "../styles/global.css";
import PageEditorBar from "../components/PageEditorBar.astro";

interface Props {
    title: string;
    theme?: string;
    isDashboard?: boolean;
    pageId?: string;
}

const { title, theme = "light", isDashboard = false, pageId } = Astro.props;
---

<!doctype html>
<html lang="es" data-theme={theme}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <!-- Favicons -->
        <link rel="icon" href="/favicon.ico" sizes="any" />
        <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
        <link
            rel="icon"
            type="image/png"
            sizes="32x32"
            href="/favicon/favicon-32x32.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="16x16"
            href="/favicon/favicon-16x16.png"
        />

        <!-- Apple Touch Icon (iOS) -->
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/favicon/apple-touch-icon.png"
        />
        <meta name="apple-mobile-web-app-title" content="Acampada Setas" />

        <!-- Progressive Web App (PWA) & Mobile Colors -->
        <link rel="manifest" href="/site.webmanifest" />
        <meta name="theme-color" content="#af0b56" />
        <meta name="mobile-web-app-capable" content="yes" />
        <meta name="apple-mobile-web-app-capable" content="yes" />
        <meta name="apple-mobile-web-app-status-bar-style" content="default" />
        <meta name="generator" content={Astro.generator} />
        <meta name="robots" content="noindex, nofollow" />

        <!-- Google Fonts: Londrina Solid for titles & Poppins for general text -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Londrina+Solid:wght@300;400;900&family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap"
            rel="stylesheet"
        />

        <title>{title} | Acampada Setas Sevilla</title>
    </head>
    <body
        class={
            isDashboard
                ? "bg-base-200 min-h-screen text-base-content"
                : "min-h-screen"
        }
    >
        <slot />
        {pageId && <PageEditorBar pageId={pageId} />}
    </body>
</html>

<style is:global>
    :root {
        --brand-primary: #af0b56;
        --brand-bg: #fcf2df;
        --brand-black: #1d1d1b;
    }

    body {
        font-family: "Poppins", sans-serif;
    }

    h1,
    h2,
    h3,
    h4,
    h5,
    h6,
    .font-londrina {
        font-family: "Londrina Solid", cursive, sans-serif;
    }

    /* Estilos cuando el Modo Edición está activo */
    body.inline-editor-active [data-editable-key],
    body.inline-editor-active [data-editable-item-id] {
        position: relative;
        transition: outline 0.15s ease-in-out;
    }

    body.inline-editor-active [data-editable-key]:hover,
    body.inline-editor-active [data-editable-item-id]:hover {
        outline: 2px dashed rgba(175, 11, 86, 0.4);
        outline-offset: 4px;
        border-radius: 4px;
    }

    body.inline-editor-active [data-editable-hidden="true"] {
        opacity: 0.45;
        filter: grayscale(40%);
        position: relative;
    }

    body.inline-editor-active .inline-editor-toolbar {
        display: inline-flex !important;
    }

    body.inline-editor-active .inline-editor-add-item-wrap {
        display: block !important;
    }

    /* En modo lectura o para visitantes no registrados, los elementos ocultos y herramientas desaparecen por completo */
    body:not(.inline-editor-active) [data-editable-hidden="true"],
    body:not(.inline-editor-active) .inline-editor-toolbar,
    body:not(.inline-editor-active) .inline-editor-add-item-wrap,
    body:not(.inline-editor-active) .inline-editor-box {
        display: none !important;
    }
</style>
