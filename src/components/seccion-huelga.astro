---
import { Megaphone, ArrowRight } from "lucide-astro";

interface Props {
  invert?: boolean;
  id?: string;
}

const { invert, id = "huelga" } = Astro.props;

// Solo se considera invertido si el parámetro es estrictamente el booleano true
const isInverted = invert === true;

// En fondo carmín (invert=true) se usa la ilustración con tejado trigo.
// En fondo trigo (invert=false) se usa la ilustración con tejado carmín.
const imageSrc = isInverted
  ? "/assets/images/cartel-huelga-invert-512.png"
  : "/assets/images/cartel-huelga-512.png";
---

<!-- Sección: 11 de Noviembre (Huelga General) -->
<section
  id={id}
  class={`w-full py-16 md:py-24 px-4 md:px-8 border-b border-black/10 relative overflow-hidden ${
    isInverted ? "bg-[#B50655] text-[#FFF0DD]" : "text-[#B50655]"
  }`}
>
  <!-- Elemento decorativo de fondo sutil -->
  <div
    class={`absolute -right-16 -bottom-16 w-96 h-96 rounded-full blur-3xl pointer-events-none ${
      isInverted ? "bg-white/5" : "bg-[#B50655]/5"
    }`}
  >
  </div>

  <div class="max-w-6xl mx-auto relative z-10">
    <div
      class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 lg:gap-16 items-center"
    >
      <!-- Gráfico a la izquierda: Ilustración PNG transparente sin recuadro ni borde -->
      <div class="md:col-span-5 flex justify-center items-center">
        <img
          src={imageSrc}
          alt="11 de noviembre una huelga como una casa"
          width="512"
          height="512"
          class="w-full max-w-[512px] max-h-[512px] aspect-square object-contain drop-shadow-2xl hover:scale-[1.03] transition-transform duration-300"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Contenido a la derecha: Badge, Título, Subtexto y Botón -->
      <div class="md:col-span-7 space-y-6 text-left">
        <!-- Badge oficial -->
        <div>
          <div
            class={`inline-flex items-center gap-2 text-xs md:text-sm font-bold uppercase tracking-wider px-4 py-1.5 rounded-full shadow-sm ${
              isInverted
                ? "bg-[#FFF0DD] text-[#B50655]"
                : "bg-[#B50655] text-[#FFF0DD]"
            }`}
          >
            <Megaphone class="w-4 h-4" />
            <span>Convocatoria</span>
          </div>
        </div>

        <!-- Título de la Huelga -->
        <h2
          class={`text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-londrina tracking-wide leading-[1.05] ${
            isInverted ? "text-[#FFF0DD]" : "text-[#B50655]"
          }`}
        >
          11 de noviembre una huelga como una casa
        </h2>

        <!-- Subtexto del título -->
        <p
          class={`text-lg md:text-xl font-medium leading-relaxed max-w-xl ${
            isInverted ? "text-[#FFF0DD]" : "text-[#B50655]"
          }`}
        >
          Paramos todo por la vivienda, los sueldos, la sanidad y la educación.<br class="hidden sm:inline" />
          Nos afecta a todos: jóvenes, familias y mayores.
        </p>

        <!-- Botón CTA hacia /huelga -->
        <div class="pt-2">
          <a
            href="/huelga"
            class={`btn font-bold text-base md:text-lg px-8 py-3.5 rounded-full shadow-md hover:shadow-lg hover:-translate-y-0.5 border-none transition-all inline-flex items-center gap-2 group w-fit max-w-full ${
              isInverted
                ? "bg-[#FFF0DD] hover:bg-white text-[#B50655]"
                : "bg-[#B50655] hover:bg-[#8f0946] text-[#FFF0DD]"
            }`}
          >
            <span>Propuesta de huelga</span>
            <ArrowRight
              class="w-4 h-4 group-hover:translate-x-1 transition-transform shrink-0"
            />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
