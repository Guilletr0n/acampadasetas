# ==============================================================================
# ACAMPADA SETAS — VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# En desarrollo local el proyecto funciona 100% de manera autónoma sin necesidad
# de credenciales externas (usando almacenamiento persistente local en .data/).
#
# Para producción en Google Cloud Run, las credenciales se configuran mediante
# Application Default Credentials (ADC) automáticamente.

# 1. Dominio y Sitio
SITE_URL=https://acampadasetas.org
DOMAIN=acampadasetas.org

# 2. Proyecto de Google Cloud Platform (Firestore & Cloud Storage)
GCP_PROJECT_ID=acampadasetas
GOOGLE_CLOUD_PROJECT=acampadasetas
FIRESTORE_DATABASE_ID=(default)
GCS_BUCKET_NAME=acampadasetas-media

# Opcional para desarrollo local si deseas conectar directamente a Firestore en la nube:
# GOOGLE_APPLICATION_CREDENTIALS=/ruta/a/tu/service-account.json

# 3. Servidor Web
PORT=8080
HOST=0.0.0.0
NODE_ENV=development
